package FinSc-Electromagnetism
version = 0.3.0
authors = "Justin Kelly"
brief   = "Layer 9 Discrete Maxwell Cochains, Poynting Flux & Minkowski Faraday Transport"

depends = FinSc-Geometry, FinSc-Multiset, FinSc-Metric-Substrate, FinSc-Phase-Unfolding, FinSc-Dihedron, base, linear
sourcedir = "src"

modules = Electromagnetism,
          Stage0.FieldStream,
          Stage0.Potential,
          Stage0.Flux,
          Stage0.TransferMatrix,
          Stage0.MultipolePoly,
          Stage1.EM.Calculus,
          Stage1.EM.EMScaleTransforms,
          Stage1.EM.Gauge,
          Stage1.EM.Hodge,
          Stage1.EM.Maxwell,
          Stage1.EM.MinkowskiFaraday,
          Stage1.Reflect.Auditor.EM
