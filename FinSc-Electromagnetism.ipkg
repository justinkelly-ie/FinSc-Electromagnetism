package FinSc-Electromagnetism
version = 0.3.0
authors = "Justin Kelly"
brief   = "Layer 3c Constructive Discrete Electromagnetism & Gauge Field Engine."

depends = FinSc-Geometry, FinSc-Multiset-Core, FinSc-Multiset-Transform, base, linear
sourcedir = "src"

modules = Electromagnetism,
          Stage0.FieldStream,
          Stage0.Potential,
          Stage0.Flux,
          Stage1.EM.Calculus,
          Stage1.EM.EMScaleTransforms,
          Stage1.EM.Gauge,
          Stage1.EM.Hodge,
          Stage1.EM.Maxwell,
          Stage1.Reflect.Auditor.EM
